{
  "dns": {
    "cache_capacity": 8192,
    "final": "dns-remote",
    "optimistic": {
      "enabled": true
    },
    "reverse_mapping": true,
    "rules": [
      {
        "domain_suffix": [
          ".lan",
          ".local",
          ".home",
          ".internal",
          ".home.arpa"
        ],
        "server": "dns-local"
      },
      {
        "domain_regex": [
          "^[^.]+$"
        ],
        "server": "dns-local"
      },
      {
        "domain": [],
        "server": "dns-bootstrap"
      },
      {
        "action": "predefined",
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "rcode": "NOERROR"
      },
      {
        "clash_mode": "direct",
        "server": "dns-direct"
      },
      {
        "clash_mode": "global",
        "server": "dns-fakeip"
      },
      {
        "domain_suffix": [
          "google.com",
          "googleapis.com",
          "gstatic.com",
          "googleusercontent.com",
          "googlevideo.com",
          "ggpht.com",
          "youtube.com",
          "ytimg.com",
          "youtu.be",
          "youtubei.googleapis.com",
          "cloudflare.com",
          "openai.com",
          "chatgpt.com",
          "anthropic.com",
          "claude.ai",
          "deepmind.google",
          "deepmind.com",
          "antigravity-unleash.goog",
          "antigravity.dev",
          "gemini.google.com",
          "aistudio.google.com",
          "makersuite.google.com",
          "generativelanguage.googleapis.com",
          "sora.com",
          "perplexity.ai",
          "x.ai",
          "grok.com",
          "copilot.microsoft.com",
          "mistral.ai",
          "poe.com",
          "midjourney.com",
          "huggingface.co",
          "goog",
          "run.app",
          "1e100.net",
          "gvt1.com"
        ],
        "server": "dns-fakeip"
      },
      {
        "domain_suffix": [
          ".cn",
          "bilibili.com",
          "baidu.com",
          "qq.com",
          "taobao.com",
          "jd.com",
          "alipay.com",
          "163.com",
          "msftconnecttest.com",
          "ntp.org",
          "pool.ntp.org",
          "time.windows.com",
          "time.apple.com",
          "time.google.com",
          "time.cloudflare.com",
          "time.edu.cn",
          "ntp.aliyun.com",
          "ntp.tencent.com",
          "cloud.mikrotik.com",
          "routeros.com",
          "mikrotik.com"
        ],
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-direct"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip"
      }
    ],
    "servers": [
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "predefined": {
          "1.1.1.1": [
            "1.1.1.1"
          ],
          "8.8.8.8": [
            "8.8.8.8"
          ],
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1"
          ],
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ],
          "doh.pub": [
            "1.12.12.12",
            "120.53.53.53"
          ]
        },
        "tag": "dns-hosts",
        "type": "hosts"
      },
      {
        "detour": "direct",
        "server": "223.5.5.5",
        "server_port": 53,
        "tag": "dns-bootstrap",
        "type": "udp"
      },
      {
        "detour": "direct",
        "server": "119.29.29.29",
        "server_port": 53,
        "tag": "dns-bootstrap-backup",
        "type": "udp"
      },
      {
        "server": "223.5.5.5",
        "server_port": 53,
        "tag": "dns-direct",
        "type": "udp"
      },
      {
        "detour": "🌐 国外流量",
        "path": "/dns-query",
        "server": "1.1.1.1",
        "server_port": 443,
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "tag": "dns-fakeip",
        "type": "fakeip"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "singbox_cache.db",
      "store_dns": true,
      "store_fakeip": true
    },
    "clash_api": {
      "default_mode": "rule",
      "external_controller": "0.0.0.0:9090",
      "secret": ""
    }
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "listen_port": 7890,
      "tag": "mixed-in",
      "type": "mixed"
    },
